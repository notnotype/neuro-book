<Configuration>
  <!-- Task 145 最终收口：全新环境 machine install + --delete-data 卸载验收。
       模板：HostFolder 必须改成 prepare-host.ps1 实际输出的路径
       （默认 <repoRoot>\.agent\tmp\t145-sandbox\t145-sandbox-input 与 ...\t145-sandbox-evidence）。 -->
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\PATH\TO\t145-sandbox-input</HostFolder>
      <SandboxFolder>C:\NeuroBook\input</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\PATH\TO\t145-sandbox-evidence</HostFolder>
      <SandboxFolder>C:\NeuroBook\evidence</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
</Configuration>
