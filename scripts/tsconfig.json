{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "types": [
            "node",
            "bun"
        ],
        "baseUrl": "..",
        "paths": {
            "#scripts/*": [
                "./scripts/*"
            ]
        }
    },
    "include": [
        "ci/agent-governance-contract.ts",
        "ci/agent-governance.ts",
        "ci/change-scope.ts",
        "ci/check-documentation.ts",
        "ci/community-files.ts",
        "ci/component-inject-tags.ts",
        "ci/message-catalogs.ts",
        "ci/workspace-graph.ts",
        "cli/agent-context.ts",
        "cli/create-agent-worktree.ts",
        "cli/test-affected.ts",
        "release/github-release.ts",
        "release/manifest.ts",
        "release/packages.ts",
        "release/pack-smoke.ts",
        "release/publish.ts",
        "release/release-plan.ts",
        "release/release.ts",
        "release/semver.ts",
        "release/tag.ts",
        "release/verify-update-feed.ts",
        "ci/validate-proper-lockfile-patch.ts",
        "types/proper-lockfile.d.ts"
    ]
}
