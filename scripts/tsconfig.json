{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "types": [
            "node",
            "bun"
        ],
        "baseUrl": "..",
        "paths": {
            "#scripts/*": [
                "./scripts/*"
            ]
        }
    },
    "include": [
        "ci/agent-governance-contract.ts",
        "ci/agent-governance.ts",
        "cli/agent-context.ts",
        "ci/validate-proper-lockfile-patch.ts",
        "types/proper-lockfile.d.ts",
        "maintenance/migrate-agent-tasks.ts",
        "maintenance/migrate-task-ownership.ts"
    ]
}
