{
    "schema": "nbook.repository-research-adapter/v1",
    "name": "neuro-book-api-config-tutorial",
    "entryPath": "/settings.preview",
    "command": [
        "node",
        "--import",
        "tsx",
        "scripts/deploy/settings-screenshot.ts"
    ],
    "arguments": [
        "--runtime",
        "--browser-executable",
        "--evidence-dir",
        "--media-dir",
        "--profile",
        "api-config-tutorial",
        "--headed",
        "false"
    ],
    "viewports": [
        [1440, 1000],
        [390, 844]
    ],
    "mediaRootEnv": "HERMES_HOME/cache/images"
}
