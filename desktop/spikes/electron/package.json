{
    "name": "@neuro-book/desktop-electron-spike",
    "private": true,
    "type": "module",
    "main": "dist/main.mjs",
    "scripts": {
        "version": "electron --version",
        "build": "bun ../shared/build.mjs && bun build.mjs",
        "audit": "bun run build && bun -e \"import('./dist/main.mjs').catch(() => process.exit(0))\"",
        "headless": "bun run build && electron dist/main.mjs --headless"
    },
    "devDependencies": {
        "electron": "latest"
    }
}
