{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "baseUrl": "../..",
        "paths": {
            "nbook/*": ["../../*"],
            "@notnotype/owned-process": ["../../packages/owned-process/src/index.ts"]
        },
        "noEmit": true,
        "types": ["node"],
        "strict": true,
        "skipLibCheck": true,
        "allowJs": false
    },
    "include": [
        "electron/src/**/*.ts",
        "shared/src/**/*.ts"
    ]
}
