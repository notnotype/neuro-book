{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "baseUrl": "../..",
        "paths": {
            "nbook/*": [
                "./*"
            ]
        },
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true
