{
    "name": "@neuro-book/desktop-electron",
    "private": true,
    "type": "module",
    "main": "dist/main.mjs",
    "scripts": {
        "version": "electron --version",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "build": "bun build.mjs",
        "audit": "bun run build && bun -e \"import('./dist/main.mjs').catch(() => process.exit(0))\"",
        "headless": "bun run build && electron dist/main.mjs --headless"
    },
    "devDependencies": {
        "@electron/asar": "^4.2.1",
        "electron": "^43.2.0"
    }
}
