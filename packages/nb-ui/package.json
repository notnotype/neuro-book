{
    "name": "@notnotype/nb-ui",
    "version": "0.2.0-alpha.0",
    "private": true,
    "type": "module",
    "description": "Shared Vue/Nuxt UI primitives for NeuroBook-derived projects.",
    "license": "AGPL-3.0-only",
    "exports": {
        ".": "./src/index.ts",
        "./nuxt": "./src/module.ts",
        "./components": "./src/components/index.ts",
        "./layout": "./src/components/layout/index.ts",
        "./composables": "./src/composables/index.ts",
        "./colorway": "./src/colorway/index.ts",
        "./theme": "./src/theme/index.ts",
        "./themes/*": "./themes/*/index.ts",
        "./testing": "./src/testing/index.ts",
        "./utils": "./src/utils/index.ts",
        "./styles.css": "./dist/nb-ui.css"
    },
    "scripts": {
        "dev": "nuxt dev playground",
        "build": "bun run build:css && nuxt build playground",
        "build:css": "tailwindcss -i ./src/tailwind.css -o ./dist/nb-ui.css",
        "typecheck": "nuxt prepare playground && vue-tsc --noEmit && vue-tsc --noEmit -p playground",
        "test": "nuxt prepare playground && vitest run",
        "test:e2e": "playwright test"
    },
    "peerDependencies": {
        "nuxt": "^4.3.1",
        "vue": "^3.5.24"
    },
    "dependencies": {
        "@nuxt/kit": "^4.3.1",
        "@vueuse/core": "^14.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "reka-ui": "^2.10.1",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@iconify-json/lucide": "^1.2.95",
        "@playwright/test": "^1.62.1",
        "@iconify/tailwind4": "^1.2.3",
        "@nuxt/cli": "^3.36.1",
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.11",
        "happy-dom": "^20.10.6",
        "nuxt": "^4.3.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vitest": "^4.1.2",
        "vue": "^3.5.24",
        "vue-tsc": "^2.2.0"
    }
}
