{
    "name": "@notnotype/nb-ui",
    "version": "0.3.0",
    "description": "Shared Vue/Nuxt UI primitives for NeuroBook-derived projects.",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/notnotype/neuro-book.git",
        "directory": "packages/nb-ui"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./nuxt": "./src/module.ts",
        "./components": "./src/components/index.ts",
        "./composables": "./src/composables/index.ts",
        "./notifications": "./src/composables/useNotification.ts",
        "./lab-sources": "./src/lab/sources.ts",
        "./colorway": "./src/colorway/index.ts",
        "./diff": "./src/diff/index.ts",
        "./text": "./src/text/index.ts",
        "./text/minimal": "./src/text/minimal.ts",
        "./text-port": "./src/text-port/index.ts",
        "./locales": "./src/locales/index.ts",
        "./colorway-contract": "./src/colorway/colorway-contract.ts",
        "./theme": "./src/theme/index.ts",
        "./themes/*": "./themes/*/index.ts",
        "./utils": "./src/utils/index.ts",
        "./tailwind.css": "./src/tailwind.css",
        "./tokens.css": "./src/tokens.css",
        "./theme.css": "./src/theme.css"
    },
    "scripts": {
        "dev": "nuxt dev playground",
        "build": "nuxt build playground",
        "typecheck": "nuxt prepare playground && vue-tsc --noEmit && vue-tsc --noEmit -p playground",
        "test": "nuxt prepare playground && vitest run",
        "test:e2e": "playwright test"
    },
    "peerDependencies": {
        "@nuxt/kit": "^4.3.1",
        "nuxt": "^4.3.1",
        "typescript": "^5.4.0 || ^6.0.0",
        "vue": "^3.5.24"
    },
    "peerDependenciesMeta": {
        "@nuxt/kit": {
            "optional": true
        },
        "nuxt": {
            "optional": true
        }
    },
    "dependencies": {
        "@iconify-json/lucide": "^1.2.95",
        "@iconify/tailwind4": "^1.2.3",
        "@vueuse/core": "^14.3.0",
        "diff": "^9.0.0",
        "clsx": "^2.1.1",
        "reka-ui": "^2.10.1",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@playwright/test": "^1.62.1",
        "@nuxt/cli": "^3.36.1",
        "@nuxt/kit": "^4.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.11",
        "happy-dom": "^20.10.6",
        "nuxt": "^4.3.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vitest": "^4.1.2",
        "vue": "^3.5.24",
        "vue-tsc": "^2.2.0"
    },
    "engines": {
        "bun": ">=1.3.14"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "themes",
        "README.md",
        "LICENSE"
    ]
}
