{
    "name": "@notnotype/nb-workbench-layout",
    "version": "0.1.0",
    "private": true,
    "description": "工作台的布局层：布局文档、投影、落点规则（纯 TS），以及标签条（Vue）；建在 nb-layout 的公开入口上，不发布。",
    "license": "AGPL-3.0-only",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./vue": "./src/vue/index.ts",
        "./lab-sources": "./src/vue/lab-sources.ts"
    },
    "scripts": {
        "test": "bun test && vitest run",
        "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.vue.json"
    },
    "dependencies": {
        "@notnotype/nb-layout": "workspace:^",
        "@notnotype/nb-ui": "workspace:^"
    },
    "devDependencies": {
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@types/bun": "^1.3.14",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.11",
        "happy-dom": "^20.10.6",
        "typescript": "^6.0.3",
        "vitest": "^4.1.2",
        "vue": "^3.5.24",
        "vue-tsc": "^3.3.7"
    },
    "peerDependencies": {
        "vue": "^3.5.24"
    },
    "engines": {
        "bun": ">=1.3.14"
    }
}
