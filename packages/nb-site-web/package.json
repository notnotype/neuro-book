{
    "name": "@notnotype/nb-site-web",
    "version": "0.1.0",
    "private": true,
    "description": "官方站的前端：Vue 3、Vite、Tailwind 与 nb-ui；只经两个合同包认识后端的接口",
    "license": "AGPL-3.0-only",
    "type": "module",
    "exports": {
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "vite build",
        "preview": "vite preview",
        "test": "bun test && vitest run",
        "test:e2e": "vite build && playwright test -c e2e/playwright.config.ts",
        "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p e2e/tsconfig.json"
    },
    "dependencies": {
        "@notnotype/nb-site-identity-contract": "workspace:*",
        "@notnotype/nb-site-telemetry-contract": "workspace:*",
        "@notnotype/nb-ui": "workspace:*",
        "echarts": "6.1.0",
        "vue": "^3.5.24",
        "vue-router": "^5.1.0"
    },
    "devDependencies": {
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.11",
        "happy-dom": "^20.10.6",
        "marked": "17.0.6",
        "tailwindcss": "^4.3.3",
        "typebox": "^1.3.6",
        "typescript": "^6.0.3",
        "vite": "^8.1.4",
        "vitest": "^4.1.2",
        "vue-tsc": "^3.3.7"
    }
}
