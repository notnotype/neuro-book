{
    "name": "@notnotype/neuro-book",
    "version": "0.0.0",
    "description": "NeuroBook v2: a local-first long-form writing workbench rebuilt on the plugin runtime.",
    "license": "AGPL-3.0-only",
    "type": "module",
    "private": true,
    "engines": {
        "bun": ">=1.3.14"
    },
    "scripts": {
        "dev": "bun src/server/dev/main.ts",
        "test": "bun run test:bun && bun run test:vitest",
        "test:bun": "bun test",
        "test:vitest": "vitest run",
        "test:e2e": "bun run build && bun run build:e2e && playwright test -c e2e/playwright.config.ts",
        "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json && vue-tsc --noEmit -p tsconfig.browser-test.json",
        "build": "bun run build:server && bun run build:web && bun run check:dist",
        "build:server": "bun build src/server/main.ts --target bun --outdir dist/server && bun build src/project/main.ts --target bun --outfile dist/server/project.js",
        "build:web": "vite build",
        "build:e2e": "vite build -c vite.e2e.config.ts",
        "check:dist": "bun scripts/check-dist.ts",
        "start": "NBOOK_WEB_ROOT=dist/web bun dist/server/main.js",
        "smoke:server": "bun scripts/smoke-server.ts",
        "lab:shot": "node scripts/lab-shot.ts"
    },
    "dependencies": {
        "@notnotype/nb-runtime": "workspace:*",
        "@vue/reactivity": "^3.5.39",
        "hono": "^4.12.30",
        "jsonc-parser": "^3.3.1",
        "proper-lockfile": "4.1.2",
        "typebox": "^1.3.6"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.95",
        "@notnotype/nb-ui": "workspace:*",
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@playwright/test": "^1.62.1",
        "@types/bun": "^1.3.14",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.11",
        "dompurify": "^3.3.3",
        "happy-dom": "^20.11.2",
        "json-editor-vue": "^0.18.1",
        "marked": "^17.0.3",
        "the-new-css-reset": "^1.11.3",
        "typescript": "^6.0.3",
        "unocss": "^66.7.5",
        "vanilla-jsoneditor": "^3.12.0",
        "vite": "^8.1.4",
        "vitest": "^4.1.10",
        "vue": "^3.5.24",
        "vue-router": "^5.1.0",
        "vue-tsc": "^3.3.7"
    }
}
