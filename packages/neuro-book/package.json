{
    "name": "@notnotype/neuro-book",
    "version": "0.0.0",
    "description": "NeuroBook v2: a local-first long-form writing workbench rebuilt on the plugin runtime.",
    "license": "AGPL-3.0-only",
    "type": "module",
    "private": true,
    "engines": {
        "bun": ">=1.3.14"
    },
    "scripts": {
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "build:server": "bun build src/server/main.ts --target bun --outdir dist/server",
        "start": "bun dist/server/main.js",
        "smoke:server": "bun scripts/smoke-server.ts"
    },
    "dependencies": {
        "@notnotype/nb-runtime": "workspace:*",
        "hono": "^4.12.30",
        "proper-lockfile": "4.1.2"
    },
    "devDependencies": {
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@types/bun": "^1.3.14",
        "typescript": "^6.0.3"
    }
}
