{
    "name": "@notnotype/neuro-book",
    "version": "0.0.0",
    "description": "NeuroBook v2: a local-first long-form writing workbench rebuilt on the plugin runtime.",
    "license": "AGPL-3.0-only",
    "type": "module",
    "private": true,
    "engines": {
        "bun": ">=1.3.14"
    },
    "scripts": {
        "dev": "bun src/server/dev/main.ts",
        "test": "bun test",
        "test:e2e": "bun run build && playwright test -c e2e/playwright.config.ts",
        "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json",
        "build": "bun run build:server && bun run build:web",
        "build:server": "bun build src/server/main.ts --target bun --outdir dist/server",
        "build:web": "vite build",
        "start": "NBOOK_WEB_ROOT=dist/web bun dist/server/main.js",
        "smoke:server": "bun scripts/smoke-server.ts"
    },
    "dependencies": {
        "@notnotype/nb-runtime": "workspace:*",
        "hono": "^4.12.30",
        "proper-lockfile": "4.1.2",
        "typebox": "^1.3.6",
        "vue": "^3.5.24"
    },
    "devDependencies": {
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@playwright/test": "^1.62.1",
        "@types/bun": "^1.3.14",
        "@vitejs/plugin-vue": "^6.0.7",
        "typescript": "^6.0.3",
        "vite": "^8.1.4",
        "vue-tsc": "^3.3.7"
    }
}
