{
    "name": "@notnotype/neuro-book",
    "version": "0.12.0",
    "description": "NeuroBook：本地优先的长篇写作工作区（v2 预览版），带命令 nbook",
    "license": "AGPL-3.0-only",
    "type": "module",
    "private": true,
    "engines": {
        "bun": ">=1.3.14"
    },
    "scripts": {
        "dev": "bun src/server/dev/main.ts",
        "test": "bun run test:bun && bun run test:vitest",
        "test:bun": "bun test",
        "test:llm": "NBOOK_LLM_TESTS=1 bun test .llm.test.ts",
        "test:vitest": "vitest run",
        "test:e2e": "bun run build && bun run build:e2e && playwright test -c e2e/playwright.config.ts",
        "build:agent-docs": "bun scripts/agent-docs.ts",
        "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json && vue-tsc --noEmit -p tsconfig.browser-test.json",
        "build": "bun run build:server && bun run build:web && bun run check:dist",
        "build:server": "bun build src/server/main.ts --target bun --external '@oh-my-pi/*' --splitting --outdir dist/server --chunk-naming 'main-[hash].[ext]' && bun build src/project/main.ts --target bun --external '@oh-my-pi/*' --outfile dist/server/project.js && bun build src/cli/main.ts --target bun --external '@oh-my-pi/*' --splitting --outdir dist/server --entry-naming nbook.js --chunk-naming 'nbook-[hash].[ext]'",
        "build:web": "vite build",
        "build:e2e": "vite build -c vite.e2e.config.ts",
        "check:dist": "bun scripts/check-dist.ts",
        "build:sdk": "bun plugin-sdk/pack.ts",
        "build:app-package": "bun run build && bun scripts/pack-app.ts",
        "build:examples": "bun plugin-sdk/build-examples.ts",
        "start": "NBOOK_WEB_ROOT=dist/web bun dist/server/main.js",
        "smoke:server": "bun scripts/smoke-server.ts",
        "lab:shot": "node scripts/lab-shot.ts",
        "page:shot": "node scripts/page-shot.ts",
        "gen:file-icons": "bun scripts/gen-file-icons.ts",
        "gen:monaco-languages": "bun scripts/gen-monaco-languages.ts",
        "perf:files": "bun scripts/perf/files-perf.ts"
    },
    "dependencies": {
        "@notnotype/nb-form": "workspace:*",
        "@notnotype/nb-harness": "workspace:*",
        "@notnotype/nb-markdown": "workspace:*",
        "@notnotype/nb-runtime": "workspace:*",
        "@oh-my-pi/pi-natives": "18.14.0",
        "@vue/reactivity": "^3.5.39",
        "commander": "^14.0.2",
        "entities": "8.0.0",
        "fast-xml-parser": "^5.11.2",
        "hono": "^4.12.30",
        "i18next": "26.5.11",
        "jsonc-parser": "^3.3.1",
        "open": "^11.0.0",
        "proper-lockfile": "4.1.2",
        "semver": "^7.8.5",
        "typebox": "^1.3.6"
    },
    "devDependencies": {
        "@iconify-json/catppuccin": "^1.2.17",
        "@iconify-json/lucide": "^1.2.95",
        "@iconify/tailwind4": "^1.2.3",
        "@iconify/utils": "3.1.4",
        "@notnotype/nb-agent-ui": "workspace:*",
        "@notnotype/nb-ui": "workspace:*",
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tiptap/core": "3.27.3",
        "@tiptap/pm": "3.27.3",
        "@types/bun": "^1.3.14",
        "@types/semver": "^7.7.1",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.11",
        "dompurify": "^3.3.3",
        "happy-dom": "^20.11.2",
        "json-editor-vue": "^0.18.1",
        "marked": "17.0.6",
        "monaco-editor": "^0.55.1",
        "postcss": "^8.5.18",
        "postcss-selector-parser": "^7.1.4",
        "rolldown": "~1.1.4",
        "rolldown-plugin-dts": "0.27.14",
        "tailwindcss": "^4.3.3",
        "the-new-css-reset": "^1.11.3",
        "typescript": "^6.0.3",
        "vanilla-jsoneditor": "^3.12.0",
        "vite": "^8.1.4",
        "vitest": "^4.1.10",
        "vue": "^3.5.24",
        "vue-router": "^5.1.0",
        "vue-tsc": "^3.3.7"
    }
}
