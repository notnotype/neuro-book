{
  "name": "@notnotype/neuro-book",
  "version": "0.9.7-canary.20260825.125115Z.d4f28c56",
  "description": "A local AI workspace for long-form novel writing, integrating a file-based workspace, Markdown Studio, story structure management, and multi-agent writing workflows.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/notnotype/neuro-book.git",
    "directory": "packages/neuro-book"
  },
  "type": "module",
  "imports": {
    "#app/*": "./*",
    "#scripts/*": "../../scripts/*"
  },
  "exports": {
    "./build": {
      "types": "./interfaces/build.ts",
      "import": "./interfaces/build.ts",
      "default": "./interfaces/build.ts"
    },
    "./product-verification": {
      "types": "./interfaces/product-verification.ts",
      "import": "./interfaces/product-verification.ts",
      "default": "./interfaces/product-verification.ts"
    }
  },
  "scripts": {
    "dev": "bun scripts/cli/source-dev.ts",
    "dev:runtime": "bun scripts/cli/source-runtime.ts",
    "dev:warmup": "bun scripts/cli/warmup-dev-server.mjs",
    "nuxt:build": "bun ../../scripts/build/build-product-runtime-image.ts",
    "nuxt:build:raw": "bun ../../node_modules/nuxt/bin/nuxt.mjs build --dotenv .env.product --preset node-server",
    "nuxt:preview": "nuxt preview",
    "analysis": "nuxt analyze --dotenv .env",
    "nuxt:prepare": "nuxt prepare",
    "build": "nuxt prepare && bun run generate && bun scripts/build/prepare-system-assets.ts && tsc",
    "system-assets:prepare": "bun scripts/build/prepare-system-assets.ts",
    "system-assets:typegen": "bun scripts/build/generate-profile-variable-types.ts",
    "profile:metadata": "bun scripts/build/prepare-system-assets.ts",
    "typecheck": "nuxt typecheck --dotenv .env.typecheck --logLevel silent",
    "scripts:typecheck": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:agent": "vitest run server/agent shared/dto",
    "test:agent-state-root": "nuxt prepare && vitest run server/workspace-files/workspace-runtime-root.test.ts server/agent/harness/agent-workspace-state-root.test.ts",
    "smoke:agent": "bun scripts/smoke/agent.ts",
    "smoke:agent-http": "bun scripts/smoke/agent-http.ts",
    "smoke:sqlite-vec": "bun scripts/smoke/sqlite-vec.ts",
    "smoke:subject-rag": "bun scripts/smoke/subject-rag.ts",
    "smoke:writing-workflow": "bun scripts/smoke/writing-workflow.ts",
    "seed:world-engine-demo": "bun scripts/seed/world-engine-demo.ts",
    "seed:heroes-story": "bun scripts/seed/heroes-story.ts",
    "seed:chapter-01-slices": "bun scripts/seed/chapter-01-slices.ts",
    "migrate": "bun scripts/db/prisma-migrate.mjs",
    "migrate:deploy": "bun scripts/db/prisma-migrate.mjs --deploy",
    "config:migrate": "bun scripts/db/migrate-config-system.ts",
    "migrate:application-state": "bun scripts/db/migrate-application-state.ts",
    "migration:check": "bun scripts/db/check-migrations.ts",
    "migrate:agent-attachments": "bun scripts/db/migrate-agent-attachments.ts",
    "migrate:agent-session-initial": "bun scripts/db/migrate-agent-session-initial.ts",
    "migrate:agent-sessions-v2": "bun scripts/db/migrate-agent-sessions-v2.ts",
    "migrate:agent-session-models": "bun scripts/maintenance/migrate-session-model-refs.ts",
    "migrate:writer-session-initial": "bun scripts/db/migrate-writer-session-initial.ts",
    "generate": "bun scripts/db/prisma-generate.mjs",
    "generate:openapi": "bun scripts/build/generate-openapi-meta.ts",
    "create-admin": "bun scripts/cli/create-admin.ts",
    "auth:create-admin": "bun scripts/cli/create-admin.ts",
    "studio": "bunx prisma studio --config ./prisma.config.ts",
    "runtime:typecheck": "bun run generate && tsc --noEmit -p server/runtime/tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@dnd-kit/helpers": "^0.3.2",
    "@dnd-kit/vue": "^0.3.2",
