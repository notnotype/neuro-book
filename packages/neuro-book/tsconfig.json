{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext"],
        "types": ["bun"],
        "strict": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "nbook/*": ["./src/*"],
            "@notnotype/nb-plugin-sdk": ["./src/sdk/index.ts"],
            "@notnotype/nb-plugin-sdk/text": ["./src/sdk/text.ts"],
            "@notnotype/nb-plugin-sdk/text/browser": ["./src/sdk/text-browser.ts"],
            "@notnotype/nb-plugin-sdk/state": ["./src/sdk/state.ts"],
            "@notnotype/nb-plugin-sdk/storage": ["./src/sdk/storage.ts"],
            "@notnotype/nb-plugin-sdk/files": ["./src/sdk/files.ts"],
            "@notnotype/nb-plugin-sdk/settings": ["./src/sdk/settings.ts"],
            "@notnotype/nb-plugin-sdk/settings/browser": ["./src/sdk/settings-browser.ts"],
            "@notnotype/nb-plugin-sdk/commands": ["./src/sdk/commands.ts"],
            "@notnotype/nb-plugin-sdk/agent": ["./src/sdk/agent.ts"],
            "@notnotype/nb-plugin-sdk/agent/jsx-runtime": ["./src/sdk/agent-jsx-runtime.ts"],
            "@notnotype/nb-plugin-sdk/workbench": ["./src/sdk/workbench.ts"],
            "@notnotype/nb-plugin-sdk/components": ["./src/sdk/components.ts"]
        }
    },
    "include": [
        "src/*.ts",
        "src/server",
        "src/project",
        "src/shared",
        "src/plugin-platform/backend",
        "src/plugin-platform/shared",
        "src/plugin-platform/build",
        "src/sdk/index.ts",
        "src/types",
        "src/plugins/*/plugin.ts",
        "src/plugins/*/backend",
        "src/plugins/*/shared",
        "src/**/*.test.ts",
        "plugin-sdk",
        "scripts",
        "vite.config.ts",
        "vite.e2e.config.ts",
        "vitest.config.ts"
    ],
    "exclude": ["plugin-sdk/template", "plugin-sdk/examples/plugins/*/web", "plugin-sdk/*.dom.test.ts", "plugin-sdk/examples/**/*.dom.test.ts", "src/**/*.dom.test.ts", "src/plugins/*/web/**/*.test.ts", "scripts/lab-shot.ts", "scripts/page-shot.ts", "scripts/page-shot.test.ts", "scripts/perf/files-perf.ts", "scripts/perf/page-agent.ts", "scripts/perf/browser-runner.ts"]
}
