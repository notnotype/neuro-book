{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext"],
        "types": ["bun"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "nbook/*": ["./src/*"]
        }
    },
    "include": [
        "src/*.ts",
        "src/server",
        "src/shared",
        "src/types",
        "src/plugins/*/plugin.ts",
        "src/plugins/*/server",
        "src/plugins/*/shared",
        "src/**/*.test.ts",
        "scripts",
        "uno.config.ts",
        "vite.config.ts",
        "vite.e2e.config.ts",
        "vitest.config.ts"
    ],
    "exclude": ["src/**/*.dom.test.ts", "scripts/lab-shot.ts"]
}
