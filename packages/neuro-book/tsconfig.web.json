{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "nbook/*": ["./src/*"]
        }
    },
    "include": ["src/web", "src/ui", "src/plugins/*/web", "src/plugins/*/plugin.ts", "src/plugins/*/shared", "src/shared", "src/manifest.ts", "src/development-manifest.ts"],
    "exclude": ["**/*.test.ts"]
}
