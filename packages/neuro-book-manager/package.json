{
    "name": "@notnotype/neuro-book-manager",
    "version": "0.1.0-canary.55",
    "description": "NeuroBook installation, runtime, toolchain and update manager.",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/notnotype/neuro-book.git",
        "directory": "packages/neuro-book-manager"
    },
    "type": "module",
    "bin": {
        "neuro-book": "dist/neuro-book.mjs"
    },
    "exports": {
        ".": "./dist/neuro-book.mjs",
        "./schema": "./dist/schema.mjs",
        "./runtime-projection": {
            "types": "./src/runtime-projection.ts",
            "bun": "./src/runtime-projection.ts",
            "import": "./dist/runtime-projection.mjs",
            "default": "./dist/runtime-projection.mjs"
        },
        "./desktop-installation": "./dist/desktop-installation-entry.mjs",
        "./desktop-uac-client": {
            "types": "./src/desktop-uac-client-entry.ts",
            "import": "./dist/desktop-uac-client-entry.mjs",
            "default": "./dist/desktop-uac-client-entry.mjs"
        },
        "./product-runtime-verifier": {
            "types": "./src/product-runtime-verifier-entry.ts",
            "import": "./dist/product-runtime-verifier-entry.mjs",
            "default": "./dist/product-runtime-verifier-entry.mjs"
        },
        "./portable": "./dist/portable.mjs",
        "./installation": {
            "types": "./src/installation-entry.ts",
            "import": "./dist/installation-entry.mjs",
            "default": "./dist/installation-entry.mjs"
        },
        "./test-support": "./src/fixtures/runtime-image.ts"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "engines": {
        "bun": ">=1.3.0"
    },
    "imports": {
        "#manager/*": "./src/*.ts"
    },
    "scripts": {
        "build": "bun scripts/build.mjs",
        "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
        "typecheck": "bun ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
        "pack:check": "bun run build && bun scripts/pack-check.mjs"
    },
    "devDependencies": {
        "@notnotype/owned-process": "file:../owned-process",
        "@notnotype/neuro-book-contracts": "file:../neuro-book-contracts",
        "@clack/prompts": "^1.0.0",
        "@types/blessed": "^0.1.27",
        "@types/bun": "^1.3.14",
        "@types/node": "^25.6.0",
        "@types/semver": "^7.7.1",
        "blessed": "^0.1.81",
        "commander": "^14.0.2",
        "fflate": "^0.8.3",
        "typebox": "^1.1.38",
        "typescript": "^5.9.3",
        "vitest": "^4.1.2",
        "@notnotype/neuro-book-test-support": "file:../neuro-book-test-support"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "proper-lockfile": "^4.1.2",
        "semver": "^7.8.5",
        "yaml": "^2.8.2"
    }
}
