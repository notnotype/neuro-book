{
    "name": "@notnotype/nb-site-server",
    "version": "0.1.0",
    "private": true,
    "description": "官方站的进程入口：命令行 nb-site、配置校验、每个模块的库连接与迁移、健康检查、日志与停止，把账号与统计两个模块装进一个 Bun 进程",
    "license": "AGPL-3.0-only",
    "type": "module",
    "engines": {
        "bun": ">=1.3.14"
    },
    "bin": {
        "nb-site": "./src/main.ts"
    },
    "exports": {
        "./package.json": "./package.json"
    },
    "scripts": {
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "build:image": "bun image/build.ts",
        "build:previous": "bun image/build-previous.ts",
        "smoke:image": "bun image/smoke.ts"
    },
    "dependencies": {
        "@notnotype/nb-flock": "workspace:*",
        "@notnotype/nb-site-identity": "workspace:*",
        "@notnotype/nb-site-identity-contract": "workspace:*",
        "@notnotype/nb-site-telemetry": "workspace:*",
        "@notnotype/nb-site-telemetry-contract": "workspace:*",
        "commander": "^14.0.2",
        "hono": "^4.12.30"
    },
    "devDependencies": {
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@notnotype/nb-site-web": "workspace:*",
        "@types/bun": "^1.3.14",
        "typescript": "^6.0.3"
    }
}
