{
    "name": "@notnotype/nb-host",
    "version": "0.1.0",
    "private": true,
    "description": "建在 nb-runtime 上的应用共用的两端宿主：只监听回环、Host 与 Origin 核对、状态根认领、内核 RPC 端口、启动与停止、诊断出口、浏览器一侧的连接与重连；应用名一律由宿主传入",
    "license": "AGPL-3.0-only",
    "type": "module",
    "engines": {
        "bun": ">=1.3.14"
    },
    "exports": {
        "./server": "./src/server/index.ts",
        "./http/contracts": "./src/shared/http-contracts.ts",
        "./socket": "./src/shared/socket.ts",
        "./web": "./src/web/index.ts",
        "./testing": "./src/testing/index.ts"
    },
    "scripts": {
        "test": "bun test",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json"
    },
    "dependencies": {
        "@notnotype/nb-file-lock": "workspace:*",
        "@notnotype/nb-runtime": "workspace:*",
        "hono": "^4.12.30",
        "typebox": "^1.3.6"
    },
    "devDependencies": {
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@types/bun": "^1.3.14",
        "typescript": "^6.0.3"
    }
}
