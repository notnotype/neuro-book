{
    "name": "@notnotype/nb-page-agent",
    "version": "0.1.0",
    "private": true,
    "description": "让 Agent 看懂并引导一个网页：文字快照与引用、定位、截图、高亮说明框；只管一个页面里的事，宿主给稳定名、文字、主题与截图",
    "license": "AGPL-3.0-only",
    "type": "module",
    "engines": {
        "bun": ">=1.3.14"
    },
    "exports": {
        ".": "./src/index.ts",
        "./api": "./src/api/index.ts",
        "./attrs": "./src/attrs.ts"
    },
    "scripts": {
        "test": "bun test src",
        "test:e2e": "bun build e2e/bundle.ts --target browser --format iife --outfile dist/e2e/page-agent.js && playwright test -c e2e/playwright.config.ts",
        "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.8.0",
        "@zumer/snapdom": "^3.8.3",
        "dom-accessibility-api": "^0.7.1",
        "typebox": "^1.3.6"
    },
    "devDependencies": {
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@playwright/test": "^1.62.1",
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.0",
        "typescript": "^6.0.3"
    }
}
