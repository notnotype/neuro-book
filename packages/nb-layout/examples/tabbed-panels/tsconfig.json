{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "strict": true,
        "noUnusedLocals": true,
        "noEmit": true,
        "skipLibCheck": false
    },
    "include": ["src"]
}
