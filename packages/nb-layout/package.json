{
    "name": "@notnotype/nb-layout",
    "version": "0.3.0",
    "description": "布局工具：布局树、尺寸求解器、落点判定（纯 TS），以及分隔条、渲染器与拖放反馈（Vue）；主题经 CSS 变量 --nb-layout-* 取。",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/notnotype/neuro-book.git",
        "directory": "packages/nb-layout"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./vue": "./src/vue/index.ts",
        "./locales": "./src/locales/index.ts",
        "./text": "./src/vue/text.ts",
        "./style.css": "./src/vue/global.css",
        "./lab-sources": "./src/vue/lab-sources.ts"
    },
    "scripts": {
        "test": "bun test && vitest run",
        "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.vue.json && tsc --noEmit -p e2e/tsconfig.json && bun scripts/examples.ts typecheck",
        "test:e2e": "bun scripts/examples.ts build && playwright test -c e2e/playwright.config.ts",
        "build:package": "bun scripts/pack.ts",
        "api:report": "bun scripts/api-report.ts report",
        "api:check": "bun scripts/api-report.ts check"
    },
    "dependencies": {
        "tabbable": "^6.5.0"
    },
    "devDependencies": {
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@playwright/test": "^1.62.1",
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.11",
        "happy-dom": "^20.10.6",
        "rolldown": "~1.1.4",
        "rolldown-plugin-dts": "0.27.14",
        "typescript": "^6.0.3",
        "vite": "^8.1.4",
        "vitest": "^4.1.2",
        "vue": "^3.5.24",
        "vue-component-meta": "~3.3.7",
        "vue-tsc": "^3.3.7"
    },
    "peerDependencies": {
        "typescript": "^5.4.0 || ^6.0.0",
        "vue": "^3.5.24"
    },
    "engines": {
        "bun": ">=1.3.14"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*-fixtures.ts",
        "!src/**/test-fixtures",
        "README.md",
        "LICENSE"
    ]
}
