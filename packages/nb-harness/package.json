{
    "name": "@notnotype/nb-harness",
    "private": true,
    "version": "0.1.0",
    "description": "NeuroBook Agent harness：会话、Profile、配置、模型、工具与 Agent 运行时，按模块以子路径导出；模型通信与 Agent 循环基于 OMP 包族。",
    "type": "module",
    "engines": {
        "bun": ">=1.3.14"
    },
    "exports": {
        ".": "./src/prototype/index.ts",
        "./testing": "./src/prototype/testing/index.ts",
        "./session": "./src/session/session.ts",
        "./session/jsonl": "./src/session/jsonl/jsonl.ts",
        "./profile": "./src/profile/profile.ts",
        "./profile/jsx-runtime": "./src/profile/jsx-runtime.ts",
        "./profile/jsx-dev-runtime": "./src/profile/jsx-dev-runtime.ts",
        "./profile/loader": "./src/profile/loader/loader.ts",
        "./config": "./src/config/config.ts",
        "./models": "./src/models/models.ts"
    },
    "scripts": {
        "test": "bun test",
        "test:llm": "NBOOK_LLM_TESTS=1 bun test .llm.test.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@notnotype/nb-profile": "workspace:*",
        "@notnotype/nb-session": "workspace:*",
        "@oh-my-pi/pi-agent-core": "18.2.5",
        "@oh-my-pi/pi-ai": "18.2.5",
        "@oh-my-pi/pi-catalog": "18.2.5",
        "@oh-my-pi/pi-natives": "18.2.5",
        "@oh-my-pi/pi-utils": "18.2.5",
        "typebox": "^1.3.6"
    },
    "devDependencies": {
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.0",
        "typescript": "^6.0.3"
    }
}
