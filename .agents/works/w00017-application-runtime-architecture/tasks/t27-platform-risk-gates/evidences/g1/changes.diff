+import {computed, type ComputedRef, type InjectionKey, type Ref} from "vue";
+import {useI18n} from "vue-i18n";
+import {useColorMode} from "#imports";
+
+// G1 实验：宿主对 SDK 模块的实现。插件只以裸模块名 `@neurobook/plugin-sdk` 引用它，
+// 运行时由 import map 转发模块或宿主模块表交给插件同一个对象。
+
+export type PluginHostContext = {hostName: string};
+
+export const PLUGIN_HOST_CONTEXT: InjectionKey<PluginHostContext> = Symbol("nbook.plugin-host-context");
+
+/** 插件组件 setup 内调用：返回宿主的全局 i18n 组合。 */
+export function useHostI18n(): {t: (key: string) => string; locale: Ref<string>} {
+    const {t, locale} = useI18n({useScope: "global"});
+    return {t: (key: string) => t(key), locale};
+}
+
+/** 插件组件 setup 内调用：返回宿主 color-mode 的当前值。 */
+export function useHostColorMode(): ComputedRef<string> {
+    const mode = useColorMode();
+    return computed(() => mode.value);
+}
