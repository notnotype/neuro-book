+// G1 实验：做法 1 的 import map。必须先于 Nuxt 注入的任何模块脚本与 modulepreload，
+// 所以放在 head 最前面。转发模块是静态文件，运行时从 window.__NB_SHARED__ 取值。
+const G1_IMPORT_MAP = JSON.stringify({
+    imports: {
+        "vue": "/g1-shared/vue.js",
+        "@notnotype/nb-ui/components": "/g1-shared/nb-ui-components.js",
+        "@neurobook/plugin-sdk": "/g1-shared/plugin-sdk.js",
+    },
+});
+
+export default defineNitroPlugin((nitroApp) => {
+    nitroApp.hooks.hook("render:html", (html, {event}) => {
+        // 实验开关：?g1-late-importmap 时不注入，由页内脚本在启动后动态插入，验证各引擎对迟到 import map 的处理。
+        if (getQuery(event)["g1-late-importmap"] !== undefined) {
+            return;
+        }
+        html.head.unshift(`<script type="importmap">${G1_IMPORT_MAP}</script>`);
+    });
+});
