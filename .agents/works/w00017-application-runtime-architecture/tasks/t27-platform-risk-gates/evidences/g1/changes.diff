+import {readFile} from "node:fs/promises";
+import {resolve, sep} from "node:path";
+
+// G1 实验：模拟设计 P7 的 `/plugins/<id>/<version>/`，从源码树外的目录提供插件构建产物，
+// 证明插件无需重新构建宿主即可加载。
+const CONTENT_TYPES: Record<string, string> = {
+    ".mjs": "text/javascript; charset=utf-8",
+    ".js": "text/javascript; charset=utf-8",
+    ".css": "text/css; charset=utf-8",
+};
+
+export default defineEventHandler(async (event) => {
+    const root = process.env.G1_PLUGIN_DIR?.trim();
+    if (!root) {
+        throw createError({statusCode: 404, statusMessage: "G1_PLUGIN_DIR 未配置"});
+    }
+    const base = resolve(root);
+    const file = resolve(base, getRouterParam(event, "path") ?? "");
+    if (!file.startsWith(base + sep)) {
+        throw createError({statusCode: 400});
+    }
+    const body = await readFile(file).catch(() => null);
+    if (!body) {
+        throw createError({statusCode: 404});
+    }
+    const extension = file.slice(file.lastIndexOf("."));
+    setResponseHeader(event, "content-type", CONTENT_TYPES[extension] ?? "application/octet-stream");
+    setResponseHeader(event, "cache-control", "no-store");
+    return body;
+});
