@@ -0,0 +1,15 @@
+import * as Vue from "vue";
+import * as NbUiComponents from "@notnotype/nb-ui/components";
+import * as PluginSdk from "nbook/app/g1/plugin-sdk";
+
+// G1 实验：宿主交给第三方插件的共享模块。两种加载做法都从这一张冻结表取值，
+// 因此插件拿到的 Vue、nb-ui 与 SDK 与宿主是同一份模块实例。
+export type SharedModules = Readonly<Record<string, Readonly<Record<string, unknown>>>>;
+
+export function createSharedModules(): SharedModules {
+    return Object.freeze({
+        "vue": Vue,
+        "@notnotype/nb-ui/components": NbUiComponents,
+        "@neurobook/plugin-sdk": PluginSdk,
+    });
+}
