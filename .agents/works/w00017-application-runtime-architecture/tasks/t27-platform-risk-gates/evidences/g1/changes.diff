+#!/usr/bin/env bun
+import {mkdir, readFile, writeFile} from "node:fs/promises";
+import {resolve} from "node:path";
+import {plugin} from "bun";
+
+// G1 实验：为做法 1 生成 import map 指向的转发模块。ESM 的具名导出必须静态列出，
+// 所以名单在宿主构建时从真实模块求出；运行时由浏览器端测试再与 __NB_SHARED__ 对账。
+// .vue 在这里只需要导出名，用空桩代替；SDK 依赖 Nuxt 的 #imports，直接读源码里的顶层导出声明。
+plugin({
+    name: "g1-export-name-stubs",
+    setup(build) {
+        build.onLoad({filter: /\.vue$/u}, () => ({contents: "export default {};", loader: "js"}));
+    },
+});
+
+async function sourceExportNames(file: string): Promise<Record<string, unknown>> {
+    const text = await readFile(file, "utf-8");
+    const names = [...text.matchAll(/^export (?:const|function) ([A-Za-z_$][\w$]*)/gmu)].map((match) => match[1]!);
+    return Object.fromEntries(names.map((name) => [name, true]));
+}
+
+const packageRoot = resolve(import.meta.dirname, "../..");
+const outDir = resolve(packageRoot, "public/g1-shared");
+const targets: {file: string; specifier: string; load: () => Promise<Record<string, unknown>>}[] = [
+    {file: "vue.js", specifier: "vue", load: () => import("vue")},
+    {file: "nb-ui-components.js", specifier: "@notnotype/nb-ui/components", load: () => import("@notnotype/nb-ui/components")},
+    {file: "plugin-sdk.js", specifier: "@neurobook/plugin-sdk", load: () => sourceExportNames(resolve(packageRoot, "app/g1/plugin-sdk.ts"))},
+];
+
+const IDENTIFIER = /^[A-Za-z_$][\w$]*$/u;
+
+await mkdir(outDir, {recursive: true});
+for (const target of targets) {
+    const names = Object.keys(await target.load()).filter((name) => name !== "default" && IDENTIFIER.test(name)).sort();
+    const source = [
+        `// 生成文件：${target.specifier} 的 import map 转发模块（${names.length} 个导出）。`,
+        `const shared = globalThis.__NB_SHARED__?.[${JSON.stringify(target.specifier)}];`,
+        `if (!shared) throw new Error(${JSON.stringify(`宿主未提供共享模块 ${target.specifier}`)});`,
+        `export const {${names.join(", ")}} = shared;`,
+        "",
+    ].join("\n");
+    await writeFile(resolve(outDir, target.file), source);
+    console.log(`${target.file}: ${names.length} exports`);
+}
