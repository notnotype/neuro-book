@@ -0,0 +1,22 @@
+import {createModuleTable} from "nbook/app/g1/module-table";
+import {createSharedModules} from "nbook/app/g1/shared-modules";
+
+// G1 实验：浏览器宿主在根组件挂载前交出共享模块。
+// __NB_SHARED__ 供 import map 转发模块读取；__NB_MODULES__ 是宿主模块表。
+export default defineNuxtPlugin({
+    name: "g1-plugin-host",
+    setup() {
+        const shared = createSharedModules();
+        const target = window as unknown as Record<string, unknown>;
+        target.__NB_SHARED__ = shared;
+        target.__NB_MODULES__ = createModuleTable(shared);
+        target.__G1__ = {
+            ready: false,
+            identity: {},
+            weak: {},
+            errors: [] as unknown[],
+            loads: {esm: 0, cjs: 0},
+            sameModuleOnReload: {},
+        };
+    },
+});
