+            <Button data-testid="host-nb-secondary" variant="secondary" size="sm">host secondary</Button>
+        </header>
+        <G1PluginSlot approach="esm" />
+        <G1PluginSlot approach="cjs" />
+        <G1PluginSlot approach="selfvue" />
+    </div>
+</template>
+
+<style scoped>
