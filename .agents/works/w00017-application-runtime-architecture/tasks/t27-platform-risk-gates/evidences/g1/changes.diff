index 00000000..b3a5fa66
--- /dev/null
+++ b/packages/neuro-book/app/g1/G1PluginSlot.vue
@@ -0,0 +1,173 @@
+<script setup lang="ts">
+import {type Component, markRaw, nextTick, onErrorCaptured, provide, ref, shallowRef} from "vue";
+import * as Vue from "vue";
+import * as NbUiComponents from "@notnotype/nb-ui/components";
+import {NB_POPOVER_Z_INDEX} from "@notnotype/nb-ui/theme";
+import {PLUGIN_HOST_CONTEXT} from "nbook/app/g1/plugin-sdk";
+import {loadClassicScript, type PluginModuleTable} from "nbook/app/g1/module-table";
+
+// G1 实验：workbench 视图容器的最小替身。它向插件视图提供宿主上下文、包一层错误边界，
+// 并负责按两种做法加载与卸载插件代码。
+const PLUGIN_ID = "example.g1";
+const G1_POPOVER_Z_INDEX = 4321;
+
+// selfvue 是对照组：插件包自带一份 Vue，只用于确认验证能发现“两份 Vue”的失败。
+const props = defineProps<{approach: "esm" | "cjs" | "selfvue"}>();
+
+type G1Global = {
+    identity: Record<string, Record<string, boolean>>;
+    weak: Record<string, {component?: WeakRef<object>; factory?: WeakRef<object>}>;
+    errors: {approach: string; message: string; info: string}[];
+    loads: Record<string, number>;
+    sameModuleOnReload: Record<string, boolean>;
+};
+
+const g1 = (): G1Global => (window as unknown as {__G1__: G1Global}).__G1__;
+const moduleTable = (): PluginModuleTable => (window as unknown as {__NB_MODULES__: PluginModuleTable}).__NB_MODULES__;
+
+provide(PLUGIN_HOST_CONTEXT, {hostName: `g1-host:${props.approach}`});
+provide(NB_POPOVER_Z_INDEX, G1_POPOVER_Z_INDEX);
+
+const SLOT_TITLES = {
+    esm: "做法 1：import map（ESM）",
+    cjs: "做法 2：宿主模块表（登记工厂 CJS）",
+    selfvue: "对照组：插件自带 Vue（ESM）",
+} as const;
+
+const view = shallowRef<Component | null>(null);
+const failure = shallowRef<Error | null>(null);
+const status = ref("idle");
+let lastModule: WeakRef<object> | null = null;
+
+onErrorCaptured((error, _instance, info) => {
+    const normalized = error instanceof Error ? error : new Error(String(error));
+    failure.value = normalized;
+    view.value = null;
+    status.value = "failed";
+    g1().errors.push({approach: props.approach, message: normalized.message, info});
+    // 阻止错误继续冒泡到应用级 errorHandler：插件抛错只影响本视图。
+    return false;
+});
+
+function pluginUrl(path: string): string {
+    return new URL(`/g1-plugins/${path}`, window.location.href).href;
+}
+
+function attachStyle(): void {
+    if (document.querySelector(`link[data-g1-plugin-css="${props.approach}"]`)) {
+        return;
+    }
+    const link = document.createElement("link");
+    link.rel = "stylesheet";
+    link.href = pluginUrl(`${props.approach}/plugin.css`);
+    link.dataset.g1PluginCss = props.approach;
+    document.head.appendChild(link);
+}
+
+function detachStyle(): void {
+    document.querySelector(`link[data-g1-plugin-css="${props.approach}"]`)?.remove();
+}
+
+async function loadModule(): Promise<Record<string, unknown>> {
+    if (props.approach === "esm" || props.approach === "selfvue") {
+        // 绝对地址：避免开发模式 Vite 改写相对动态导入；裸模块名由页面 import map 解析。
+        return await import(/* @vite-ignore */ pluginUrl(`${props.approach}/plugin.mjs`)) as Record<string, unknown>;
+    }
+    const table = moduleTable();
+    if (!table.has(PLUGIN_ID)) {
+        await loadClassicScript(pluginUrl("cjs/plugin.cjs.js"));
+    }
+    const factory = table.factoryOf(PLUGIN_ID);
+    if (factory) {
+        g1().weak.cjs = {...g1().weak.cjs, factory: new WeakRef(factory)};
+    }
+    return table.materialize(PLUGIN_ID);
+}
+
+async function load(): Promise<void> {
+    failure.value = null;
+    status.value = "loading";
+    try {
+        const mod = await loadModule();
+        const previous = lastModule?.deref();
+        if (previous !== undefined) {
+            g1().sameModuleOnReload[props.approach] = previous === mod;
+        }
+        lastModule = new WeakRef(mod);
+        g1().loads[props.approach] = (g1().loads[props.approach] ?? 0) + 1;
+        g1().identity[props.approach] = {
+            vueRef: mod.probeVueRef === Vue.ref,
+            nbButton: mod.probeNbButton === NbUiComponents.Button,
+            sdkKey: mod.probeSdkKey === PLUGIN_HOST_CONTEXT,
+        };
+        const component = mod.component as object;
+        g1().weak[props.approach] = {...g1().weak[props.approach], component: new WeakRef(component)};
+        attachStyle();
+        view.value = markRaw(component) as Component;
+        status.value = "mounted";
+    } catch (error) {
+        failure.value = error instanceof Error ? error : new Error(String(error));
+        status.value = "load-failed";
+    }
+}
+
+async function unload(): Promise<void> {
+    view.value = null;
+    failure.value = null;
+    await nextTick();
+    detachStyle();
+    if (props.approach === "cjs") {
+        moduleTable().unregister(PLUGIN_ID);
+    }
+    status.value = "unloaded";
+}
+</script>
+
+<template>
+    <section class="g1-slot" :data-g1-slot="props.approach">
+        <header class="g1-slot__bar">
+            <strong>{{ SLOT_TITLES[props.approach] }}</strong>
+            <span :data-testid="`slot-status-${props.approach}`">{{ status }}</span>
+            <button :data-testid="`load-${props.approach}`" class="g1-slot__btn" type="button" @click="load">加载</button>
+            <button :data-testid="`unload-${props.approach}`" class="g1-slot__btn" type="button" @click="unload">卸载</button>
+        </header>
+        <div class="g1-slot__body">
+            <div v-if="failure" :data-testid="`slot-error-${props.approach}`" class="g1-slot__error">
+                插件视图出错：{{ failure.message }}
+            </div>
+            <component :is="view" v-else-if="view" :variant="props.approach" />
+            <div v-else class="g1-slot__empty">未加载</div>
+        </div>
+    </section>
+</template>
+
+<style scoped>
+.g1-slot {
+    border: 1px solid var(--border-subtle, #8884);
+    border-radius: 8px;
+    padding: 12px;
+    display: flex;
+    flex-direction: column;
+    gap: 8px;
+}
+
+.g1-slot__bar {
+    display: flex;
+    gap: 8px;
+    align-items: center;
+}
+
+.g1-slot__btn {
+    padding: 2px 10px;
+    border: 1px solid currentColor;
+    border-radius: 4px;
+}
+
+.g1-slot__error {
+    color: #e5484d;
+}
+
+.g1-slot__empty {
+    opacity: 0.6;
+}
+</style>
diff --git a/packages/neuro-book/app/g1/module-table.ts b/packages/neuro-book/app/g1/module-table.ts
new file mode 100644
index 00000000..1b6f3f21
--- /dev/null
+++ b/packages/neuro-book/app/g1/module-table.ts
@@ -0,0 +1,92 @@
+import type {SharedModules} from "nbook/app/g1/shared-modules";
+
+// G1 实验：做法 2「宿主模块表」。插件脚本执行时只调用 register 登记工厂；
+// 宿主物化时注入只认共享表的 require，禁用时把工厂和导出从表中删除。
+
+type ModuleExports = Record<string, unknown>;
+export type PluginFactory = (
+    require: (specifier: string) => unknown,
+    module: {exports: ModuleExports},
+    exports: ModuleExports,
+) => void;
+
+export type PluginModuleTable = Readonly<{
+    register(id: string, factory: PluginFactory): void;
+    materialize(id: string): ModuleExports;
+    unregister(id: string): boolean;
+    has(id: string): boolean;
+    ids(): string[];
+    /** 仅供 G1 取证：返回当前登记的工厂函数，用来建立弱引用。 */
+    factoryOf(id: string): PluginFactory | undefined;
+}>;
+
+export function createModuleTable(shared: SharedModules): PluginModuleTable {
+    const factories = new Map<string, PluginFactory>();
+    const materialized = new Map<string, ModuleExports>();
+
+    function requireShared(specifier: string): unknown {
+        if (Object.hasOwn(shared, specifier)) {
+            return shared[specifier];
+        }
+        const loaded = materialized.get(specifier);
+        if (loaded) {
+            return loaded;
+        }
+        throw new Error(`plugin require("${specifier}") 不在宿主模块表中`);
+    }
+
+    return Object.freeze({
+        register(id: string, factory: PluginFactory): void {
+            if (factories.has(id) || materialized.has(id)) {
+                throw new Error(`插件模块 ${id} 重复登记`);
+            }
+            factories.set(id, factory);
+        },
+        materialize(id: string): ModuleExports {
+            const cached = materialized.get(id);
+            if (cached) {
+                return cached;
+            }
+            const factory = factories.get(id);
+            if (!factory) {
+                throw new Error(`插件模块 ${id} 未登记`);
+            }
+            const module = {exports: {} as ModuleExports};
+            factory(requireShared, module, module.exports);
+            materialized.set(id, module.exports);
+            return module.exports;
+        },
+        unregister(id: string): boolean {
+            const removedFactory = factories.delete(id);
+            const removedExports = materialized.delete(id);
+            return removedFactory || removedExports;
+        },
+        has(id: string): boolean {
+            return factories.has(id) || materialized.has(id);
+        },
+        ids(): string[] {
+            return [...new Set([...factories.keys(), ...materialized.keys()])];
+        },
+        factoryOf(id: string): PluginFactory | undefined {
+            return factories.get(id);
+        },
+    });
+}
+
+/** 以经典脚本加载插件包；脚本只负责调用 register，加载完即可移除元素。 */
+export function loadClassicScript(url: string): Promise<void> {
+    return new Promise((resolve, reject) => {
+        const script = document.createElement("script");
+        script.src = url;
+        script.async = true;
+        script.onload = () => {
+            script.remove();
+            resolve();
+        };
+        script.onerror = () => {
+            script.remove();
+            reject(new Error(`插件脚本加载失败：${url}`));
+        };
+        document.head.appendChild(script);
+    });
+}
